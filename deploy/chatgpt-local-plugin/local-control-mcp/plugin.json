{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "local-control-mcp",
  "version": "0.3.6",
  "description": "Local Control MCP 提供设备传输。当前宿主先用覆盖目标和操作的原生能力，缺能力或无法到达目标时可使用已授权 LCM。",
  "keywords": [
    "mcp",
    "remote",
    "desktop",
    "local",
    "project-control"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Local Control MCP",
        "shortDescription": "自托管设备连接与操作",
        "longDescription": "对准确已登记设备执行文件、终端和设备操作。LCM 实际技术故障时可按既有授权使用同设备 RDC。",
        "developerName": "YUAN",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "brandColor": "#2563EB",
        "composerIcon": "./assets/local-control-mcp.svg",
        "logo": "./assets/local-control-mcp.svg"
      }
    }
  },
  "author": {
    "name": "YUAN"
  }
}
