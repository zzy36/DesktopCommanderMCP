{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "local-control-mcp",
  "version": "0.3.5",
  "description": "Local Control MCP：本机 Codex 使用原生能力，远程 LCM 优先；同作用域、同 D0 的 RDC 用于故障恢复，LCM 健康后回切。",
  "keywords": [
    "mcp",
    "remote",
    "desktop",
    "local",
    "project-control"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Local Control MCP",
        "shortDescription": "自托管、项目隔离的本地与远程设备控制",
        "longDescription": "自托管的文件、终端与远程设备控制。按真实作用域和设备授权；LCM 或其 UI/discovery 阻塞时允许 RDC 修复，恢复后回到 LCM。",
        "developerName": "YUAN",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "brandColor": "#2563EB",
        "composerIcon": "./assets/local-control-mcp.svg",
        "logo": "./assets/local-control-mcp.svg"
      }
    }
  },
  "author": {
    "name": "YUAN"
  }
}
